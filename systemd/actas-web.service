[Unit]
Description=Actas Electoral - Web (Gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/actas
EnvironmentFile=/opt/actas/.env
ExecStart=/opt/actas/.venv/bin/gunicorn \
    --workers 4 \
    --timeout 120 \
    --bind unix:/run/actas/actas.sock \
    --chdir /opt/actas \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
PrivateTmp=true
Restart=on-failure
RuntimeDirectory=actas

[Install]
WantedBy=multi-user.target
