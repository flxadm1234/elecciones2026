[Unit]
Description=Actas Electoral - Celery Worker
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/actas
EnvironmentFile=/opt/actas/.env
ExecStart=/opt/actas/.venv/bin/celery \
    --app=config.celery.app worker \
    --loglevel=INFO \
    --concurrency=4 \
    --queues=default,high_priority,low_priority
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
